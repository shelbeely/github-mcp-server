{
  "annotations": {
    "title": "Delete file",
    "readOnlyHint": false,
    "destructiveHint": true
  },
  "description": "Delete a file from a GitHub repository",
  "inputSchema": {
    "properties": {
      "ai_model": {
        "description": "Optional: AI model name to include in commit metadata (e.g., 'gpt-4', 'claude-3'). Defaults to 'GitHub MCP Server' if not provided.",
        "type": "string"
      },
      "branch": {
        "description": "Branch to delete the file from",
        "type": "string"
      },
      "message": {
        "description": "Commit message",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (username or organization)",
        "type": "string"
      },
      "path": {
        "description": "Path to the file to delete",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "path",
      "message",
      "branch"
    ],
    "type": "object"
  },
  "name": "delete_file"
}